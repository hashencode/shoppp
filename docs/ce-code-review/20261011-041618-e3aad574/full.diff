+async function compiledMarker(
+  request: Request,
+  environment: Environment,
+): Promise<StorefrontReleaseMarker | null> {
+  if (!environment.CF_VERSION_METADATA?.id) return null;
+  const asset = await environment.ASSETS.fetch(
