+
+export async function completeStorefrontPublication(
+  options: {
+    source: PublicationSource;
+    target: PublicationTarget;
+    identity: StorefrontPublicationIdentity;
+    run: PublicationRun;
+    artifactDigest: string;
+    reportDigest: string;
+    expectedWorkerVersionId?: string;
