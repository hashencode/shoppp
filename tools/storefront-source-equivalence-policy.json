{
  "schemaVersion": 1,
  "canonicalViewports": [
    { "id": "desktop", "width": 1440, "height": 1000 },
    { "id": "laptop", "width": 1024, "height": 900 },
    { "id": "tablet", "width": 768, "height": 1024 },
    { "id": "mobile", "width": 390, "height": 844 }
  ],
  "thresholds": {
    "channelTolerance": 16,
    "computedStyleNumericPx": 0.5,
    "fullPageChangedPixelRatio": 0.01,
    "fullPageHeightRatio": 0.005,
    "geometryEdgePx": 2,
    "namedStateChangedPixelRatio": 0.005
  },
  "resources": {
    "heavyBatchDefaultWorkers": 1,
    "maxConcurrentBrowserWorkers": 2,
    "modelInspection": "ranked-ambiguous-crops-only",
    "scriptFirst": true
  },
  "requiredEvidence": [
    "assets",
    "computedStyles",
    "domInventory",
    "fonts",
    "geometry",
    "interactionStates",
    "links",
    "motionStates",
    "responsiveStates",
    "runtimeDiagnostics",
    "visibleCopy"
  ],
  "themes": [
    {
      "id": "fashion-store",
      "acceptanceAdapterExport": "fashionStoreAcceptanceAdapters",
      "acceptanceAdapterPath": "apps/storefront/app/themes/fashion-store/acceptance-adapter.ts",
      "acceptance": {
        "browserConfig": "apps/storefront/playwright.fashion-store.config.ts",
        "browserProject": "fashion-store-desktop",
        "focusedStates": [
          { "id": "search-open", "modes": ["interaction"] },
          { "id": "collection-slide-1", "modes": ["temporal", "interaction"] },
          { "id": "cart-open", "modes": ["interaction"] },
          { "id": "marquee-paused", "modes": ["temporal"] },
          { "id": "scroll-progress-visible", "modes": ["scroll-fixed"] }
        ],
        "implementationRuntimeReadySelector": "[data-fashion-store-source-parity][data-runtime-status='ready']",
        "pageCommand": ["bun", "run", "--cwd", "apps/storefront", "test:fashion-store"],
        "sourceRuntimeReadySelector": ".swiper.slider-three-slide"
