{
  "schemaVersion": 1,
  "canonicalViewports": [
    { "id": "desktop", "width": 1440, "height": 1000 },
    { "id": "laptop", "width": 1024, "height": 900 },
    { "id": "tablet", "width": 768, "height": 1024 },
    { "id": "mobile", "width": 390, "height": 844 }
  ],
  "thresholds": {
    "channelTolerance": 16,
    "computedStyleNumericPx": 0.5,
    "fullPageChangedPixelRatio": 0.01,
    "fullPageHeightRatio": 0.005,
    "geometryEdgePx": 2,
    "namedStateChangedPixelRatio": 0.005
  },
  "resources": {
    "heavyBatchDefaultWorkers": 1,
    "maxConcurrentBrowserWorkers": 2,
    "modelInspection": "ranked-ambiguous-crops-only",
    "scriptFirst": true
  },
  "requiredEvidence": [
    "assets",
    "computedStyles",
    "domInventory",
    "fonts",
    "geometry",
    "interactionStates",
    "links",
    "motionStates",
    "responsiveStates",
    "runtimeDiagnostics",
    "visibleCopy"
  ],
  "themes": [
    {
      "id": "fashion-store",
      "acceptance": {
        "browserConfig": "apps/storefront/playwright.fashion-store.config.ts",
        "browserProject": "fashion-store-desktop"
      },
      "authorizedSourceRoot": "templates/Crafto - The Multipurpose HTML5 Template/html",
      "equivalenceScope": ["home", "shop-left", "shop-none", "shop-right", "product"],
      "manifestExport": "fashionStoreManifest",
      "manifestPath": "apps/storefront/app/themes/fashion-store/manifest.ts",
      "pages": [
        {
          "acceptanceAdapterExport": "fashionStoreAcceptanceAdapters",
          "acceptanceAdapterPath": "apps/storefront/app/themes/fashion-store/acceptance-adapter.ts",
          "applicableModes": ["fallback", "interaction", "scroll-fixed", "static", "temporal"],
          "behaviorContractExport": "fashionStoreBehaviorContract",
          "behaviorContractPath": "apps/storefront/app/themes/fashion-store/behavior-contract.ts",
          "focusedStates": [
            { "id": "search-open", "modes": ["interaction"] },
            { "id": "collection-slide-1", "modes": ["temporal", "interaction"] },
            { "id": "cart-open", "modes": ["interaction"] },
            { "id": "marquee-paused", "modes": ["temporal"] },
            { "id": "scroll-progress-visible", "modes": ["scroll-fixed"] }
          ],
          "id": "home",
          "implementationRoute": "/",
          "implementationRuntimeReadySelector": "[data-fashion-store-source-parity][data-runtime-status='ready']",
          "pageCommand": ["bun", "run", "--cwd", "apps/storefront", "test:fashion-store"],
          "pageType": "home",
          "requiredContractFacets": [
            "behaviorContractPath",
            "homeSectionCount",
            "regionOrder",
            "stylesheetOrder"
          ],
          "sourceContractPath": "apps/storefront/app/themes/fashion-store/source-contract.ts",
          "sourceEntry": "demo-fashion-store.html",
