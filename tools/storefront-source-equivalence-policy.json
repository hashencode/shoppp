      "equivalenceScope": ["home"],
      "authorizedSourceRoot": "templates/Crafto - The Multipurpose HTML5 Template/html",
      "behaviorContractExport": "fashionStoreBehaviorContract",
      "behaviorContractPath": "apps/storefront/app/themes/fashion-store/behavior-contract.ts",
      "sourceEntry": "demo-fashion-store.html",
      "sourceEntrySha256": "55a046515e485ffca42a41af720c3fa5faa8114605075755f9edada8f35f2465",
      "sourceContractPath": "apps/storefront/app/themes/fashion-store/source-contract.ts",
      "sourceFirstHero": "images/demo-fashion-store-slider-01.jpg",
      "sourceRegionsExport": "fashionStoreSourceRegions",
      "upstreamPath": "apps/storefront/app/themes/fashion-store/UPSTREAM.md",
      "requiredContractFacets": [
        "behaviorContractPath",
        "homeSectionCount",
        "regionOrder",
        "stylesheetOrder"
      ]
