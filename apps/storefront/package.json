{
  "name": "@shoppp/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run prepare:release && nuxt generate && bun scripts/finalize-static.ts && wrangler deploy --dry-run --outdir worker-dist --env=\"\"",
    "dev": "bun run prepare:release && nuxt dev",
    "prepare:release": "bun scripts/prepare-release.ts",
    "test": "bun test tests",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:e2e": "playwright test",
    "test:perf": "bun scripts/check-bundle-budget.ts && playwright test --config playwright.performance.config.ts",
    "typecheck": "nuxt typecheck",
    "verify:static": "bun scripts/verify-static.ts"
  },
  "dependencies": {
    "@shoppp/contracts": "workspace:*",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.10.0",
    "@pinia/nuxt": "1.0.1",
    "nuxt": "4.5.1",
    "pinia": "4.0.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.8",
    "wrangler": "4.115.0"
  }
}
