{
  "name": "@shoppp/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "accept:fashion-store": "bun run test:fashion-store",
    "build": "bun run prepare:release && bun run prepare:experience && nuxt generate && bun scripts/finalize-static.ts && wrangler deploy --dry-run --outdir worker-dist --env=\"\"",
    "build:preview:fashion-store": "bun scripts/prepare-theme-preview-fixture.ts fashion-store && STOREFRONT_BUILD_MODE=preview STOREFRONT_EXPERIENCE_FILE=fixtures/experience/.generated/fashion-store-preview-input.json bun run build",
    "build:preview-worker": "wrangler deploy --dry-run --config wrangler.preview.jsonc --outdir preview-worker-dist",
    "dev": "bun run prepare:release && bun run prepare:experience && nuxt dev",
    "dev:fashion-store": "bun scripts/dev-fashion-store.ts --source=local --home=combined",
    "dev:fashion-store:staging": "bun scripts/dev-fashion-store.ts --source=staging",
    "dev:fashion-store:isolated": "bun scripts/dev-fashion-store.ts --source=local --home=isolated",
    "dev:fashion-store:live": "bun run dev:fashion-store:staging",
    "dev:fashion-store:home-isolated": "bun run dev:fashion-store:isolated",
    "prepare:experience": "bun scripts/prepare-experience.ts",
    "prepare:release": "bun scripts/prepare-release.ts",
    "test": "bun test tests",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:e2e": "playwright test",
    "test:fashion-store": "bun run test:fashion-store:unit && bun run test:fashion-store:browser && bun run test:fashion-store:acceptance",
    "test:fashion-store:unit": "bun ../../tools/run-fashion-store-acceptance.ts --scope=theme --stage=unit",
    "test:fashion-store:browser": "bun run test:fashion-store-live && PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.fashion-store.config.ts && bun run test:fashion-store-home:combined && bun run test:fashion-store-home:isolated",
    "test:fashion-store:acceptance": "bun ../../tools/run-fashion-store-acceptance.ts --scope=theme --stage=behavior",
    "test:fashion-store-home:combined": "STOREFRONT_FASHION_HOME_PROFILE=combined PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.fashion-store-live-unified-home.config.ts",
    "test:fashion-store-home:isolated": "STOREFRONT_FASHION_HOME_PROFILE=isolated PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.fashion-store-live-unified-home.config.ts",
    "test:fashion-store-live": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.fashion-store-live.config.ts",
    "test:fidelity": "bun test ../../tools/theme-fidelity-report.test.ts",
    "test:perf": "playwright test --config playwright.performance.config.ts",
    "test:perf:fashion-store": "STOREFRONT_THEME=fashion-store playwright test --config playwright.performance.config.ts",
    "test:perf:motion": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.fashion-store-animation-performance.config.ts --workers=1",
    "test:preview": "playwright test e2e/theme-preview.spec.ts",
    "test:themes": "bun run test:fashion-store && bun run test:perf:fashion-store -- --workers=1",
    "typecheck": "nuxt typecheck",
    "verify:static": "bun scripts/verify-static.ts",
    "verify:product-parity": "bun scripts/verify-fashion-store-product-parity.ts",
    "verify:themes": "bun scripts/verify-themes.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@nuxt/image": "2.1.0",
    "@pinia/nuxt": "1.0.1",
    "@shoppp/contracts": "workspace:*",
    "bootstrap": "5.3.2",
    "gsap": "3.15.0",
    "nuxt": "4.5.1",
    "pinia": "4.0.2",
    "swiper": "14.2.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.8",
    "wrangler": "4.115.0"
  }
}
