{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shoppp-storefront-preview",
  "main": "./worker/preview-access.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PREVIEW_ARTIFACTS",
      "bucket_name": "shoppp-storefront-preview-artifacts",
    },
  ],
  "services": [
    {
      "binding": "PREVIEW_AUTH",
      "service": "shoppp-api-staging",
    },
  ],
  "vars": {
    "PREVIEW_ORIGIN": "https://preview.example.invalid",
  },
}
