{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production and staging intentionally bind neither preview artifacts nor the preview entrypoint.
  "name": "shoppp-storefront-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/.well-known/shoppp-release", "/.well-known/shoppp-release/catalog"],
  },
  "services": [
    {
      "binding": "API",
      "service": "shoppp-api-staging",
    },
  ],
  "env": {
    "staging": {
      "name": "shoppp-storefront-staging",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "services": [
        {
          "binding": "API",
          "service": "shoppp-api-staging",
        },
      ],
    },
    "production": {
      "name": "shoppp-storefront-production",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "services": [
        {
          "binding": "API",
          "service": "shoppp-api-production",
        },
      ],
    },
  },
}
