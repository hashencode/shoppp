{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shoppp-api-development",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-22",
  "vars": {
    "ENVIRONMENT": "development",
    "RESOURCE_NAMESPACE": "shoppp-development",
    "PUBLIC_ORIGIN": "https://development.example.invalid",
    "ACCESS_ISSUER": "https://shoppp.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "development-audience",
    "MEDIA_PUBLIC_ORIGIN": "https://media-development.example.invalid",
    "STOREFRONT_ORIGIN": "https://storefront-development.example.invalid",
    "TAX_MODE": "zero",
    "RESERVATION_TTL_MINUTES": "30",
    "GUEST_ORDER_TOKEN_TTL_HOURS": "720",
    "PAYMENT_CANCEL_URL": "https://storefront-development.example.invalid/checkout",
    "PAYMENT_SUCCESS_URL": "https://storefront-development.example.invalid/checkout/complete?session_id={CHECKOUT_SESSION_ID}",
    "EMAIL_FROM": "orders@development.example.invalid",
    "TURNSTILE_REQUIRED": "false",
    "TURNSTILE_HOSTNAMES": "storefront-development.example.invalid",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000001",
    "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000010",
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoppp-development",
      "database_id": "00000000-0000-0000-0000-000000000010",
      "preview_database_id": "00000000-0000-0000-0000-000000000011",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "shoppp-development-media",
      "preview_bucket_name": "shoppp-development-media-preview",
    },
    {
      "binding": "REPORT_EXPORTS",
      "bucket_name": "shoppp-development-report-exports",
      "preview_bucket_name": "shoppp-development-report-exports-preview",
    },
    {
      "binding": "PRIVACY_EXPORTS",
      "bucket_name": "shoppp-development-privacy-exports",
      "preview_bucket_name": "shoppp-development-privacy-exports-preview",
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "shoppp-development-d1-backups",
      "preview_bucket_name": "shoppp-development-d1-backups-preview",
    },
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "11002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "OBSERVABILITY",
      "dataset": "shoppp_development_observability",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "shoppp-development-notifications",
      },
    ],
    "consumers": [
      {
        "queue": "shoppp-development-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "shoppp-development-notifications-dlq",
      },
      {
        "queue": "shoppp-development-notifications-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "workflows": [
    {
      "name": "shoppp-development-notification-delivery",
      "binding": "NOTIFICATION_WORKFLOW",
      "class_name": "NotificationDeliveryWorkflow",
    },
    {
      "name": "shoppp-development-d1-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow",
      "schedules": ["0 0 * * *"],
    },
  ],
  "env": {
    "staging": {
      "name": "shoppp-api-staging",
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "RESOURCE_NAMESPACE": "shoppp-staging",
        "PUBLIC_ORIGIN": "https://shoppp-api-staging.hashencode.workers.dev",
        "ACCESS_ISSUER": "https://hashencode.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "25b9bf3fb5e9611012d068230a4320ae2fb70c6e9ab682d0fb615c9c36f226a0",
        "MEDIA_PUBLIC_ORIGIN": "https://pub-9d69c563922a48908ace4fc05c1f3fc5.r2.dev",
        "STOREFRONT_ORIGIN": "https://shoppp-storefront-staging.hashencode.workers.dev",
        "TAX_MODE": "zero",
        "RESERVATION_TTL_MINUTES": "30",
        "GUEST_ORDER_TOKEN_TTL_HOURS": "720",
        "PAYMENT_CANCEL_URL": "https://shoppp-storefront-staging.hashencode.workers.dev/checkout",
        "PAYMENT_SUCCESS_URL": "https://shoppp-storefront-staging.hashencode.workers.dev/checkout/complete?session_id={CHECKOUT_SESSION_ID}",
        "EMAIL_FROM": "orders@shoppp-staging.hashencode.workers.dev",
        "TURNSTILE_REQUIRED": "true",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEBRLp3a3K1o2E6j",
        "TURNSTILE_HOSTNAMES": "shoppp-storefront-staging.hashencode.workers.dev",
        "CLOUDFLARE_ACCOUNT_ID": "449e7f42fe4c4e55d5c674e2e7c57c8d",
        "D1_DATABASE_ID": "0c84c9e0-5ef1-4897-815e-5ec7efb7582e",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shoppp-staging",
          "database_id": "0c84c9e0-5ef1-4897-815e-5ec7efb7582e",
          "preview_database_id": "d321a324-93dd-4698-bfa3-eae5b66c9290",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "shoppp-staging-media",
          "preview_bucket_name": "shoppp-staging-media-preview",
        },
        {
          "binding": "REPORT_EXPORTS",
          "bucket_name": "shoppp-staging-report-exports",
          "preview_bucket_name": "shoppp-staging-report-exports-preview",
        },
        {
          "binding": "PRIVACY_EXPORTS",
          "bucket_name": "shoppp-staging-privacy-exports",
          "preview_bucket_name": "shoppp-staging-privacy-exports-preview",
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "shoppp-staging-d1-backups",
          "preview_bucket_name": "shoppp-staging-d1-backups-preview",
        },
      ],
      "ratelimits": [
        {
          "name": "ANALYTICS_RATE_LIMITER",
          "namespace_id": "12002",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "CHECKOUT_RATE_LIMITER",
          "namespace_id": "12001",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "OBSERVABILITY",
          "dataset": "shoppp_staging_observability",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_QUEUE",
            "queue": "shoppp-staging-notifications",
          },
        ],
        "consumers": [
          {
            "queue": "shoppp-staging-notifications",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "shoppp-staging-notifications-dlq",
          },
          {
            "queue": "shoppp-staging-notifications-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
      "workflows": [
        {
          "name": "shoppp-staging-notification-delivery",
          "binding": "NOTIFICATION_WORKFLOW",
          "class_name": "NotificationDeliveryWorkflow",
        },
        {
          "name": "shoppp-staging-d1-backup",
          "binding": "BACKUP_WORKFLOW",
          "class_name": "D1BackupWorkflow",
          "schedules": ["0 0 * * *"],
        },
      ],
    },
    "production": {
      "name": "shoppp-api-production",
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "vars": {
        "ENVIRONMENT": "production",
        "RESOURCE_NAMESPACE": "shoppp-production",
        "PUBLIC_ORIGIN": "https://api.example.invalid",
        "ACCESS_ISSUER": "https://shoppp.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "production-audience",
        "MEDIA_PUBLIC_ORIGIN": "https://media.example.invalid",
        "STOREFRONT_ORIGIN": "https://shop.example.invalid",
        "TAX_MODE": "zero",
        "RESERVATION_TTL_MINUTES": "30",
        "GUEST_ORDER_TOKEN_TTL_HOURS": "720",
        "PAYMENT_CANCEL_URL": "https://shop.example.invalid/checkout",
        "PAYMENT_SUCCESS_URL": "https://shop.example.invalid/checkout/complete?session_id={CHECKOUT_SESSION_ID}",
        "EMAIL_FROM": "orders@example.invalid",
        "TURNSTILE_REQUIRED": "true",
        "TURNSTILE_SITE_KEY": "replace-with-production-turnstile-site-key",
        "TURNSTILE_HOSTNAMES": "shop.example.invalid",
        "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000003",
        "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000030",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shoppp-production",
          "database_id": "00000000-0000-0000-0000-000000000030",
          "preview_database_id": "00000000-0000-0000-0000-000000000031",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "shoppp-production-media",
          "preview_bucket_name": "shoppp-production-media-preview",
        },
        {
          "binding": "REPORT_EXPORTS",
          "bucket_name": "shoppp-production-report-exports",
          "preview_bucket_name": "shoppp-production-report-exports-preview",
        },
        {
          "binding": "PRIVACY_EXPORTS",
          "bucket_name": "shoppp-production-privacy-exports",
          "preview_bucket_name": "shoppp-production-privacy-exports-preview",
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "shoppp-production-d1-backups",
          "preview_bucket_name": "shoppp-production-d1-backups-preview",
        },
      ],
      "ratelimits": [
        {
          "name": "ANALYTICS_RATE_LIMITER",
          "namespace_id": "13002",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "CHECKOUT_RATE_LIMITER",
          "namespace_id": "13001",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "OBSERVABILITY",
          "dataset": "shoppp_production_observability",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_QUEUE",
            "queue": "shoppp-production-notifications",
          },
        ],
        "consumers": [
          {
            "queue": "shoppp-production-notifications",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "shoppp-production-notifications-dlq",
          },
          {
            "queue": "shoppp-production-notifications-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
      "workflows": [
        {
          "name": "shoppp-production-notification-delivery",
          "binding": "NOTIFICATION_WORKFLOW",
          "class_name": "NotificationDeliveryWorkflow",
        },
        {
          "name": "shoppp-production-d1-backup",
          "binding": "BACKUP_WORKFLOW",
          "class_name": "D1BackupWorkflow",
          "schedules": ["0 0 * * *"],
        },
      ],
    },
  },
}
