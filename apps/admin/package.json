{
  "name": "@shoppp/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:production",
    "dev": "bun --env-file=../../.env ../../tools/dev-admin-authenticated.ts",
    "dev:test": "bun --env-file=../../.env ../../tools/dev-admin-authenticated.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build:test": "tsc -b && rsbuild build --env-mode test && rm -f dist/mockServiceWorker.js",
    "build:production": "tsc -b && rsbuild build --env-mode production && rm -f dist/mockServiceWorker.js && wrangler deploy --dry-run --outdir worker-dist --env=\"\"",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "test:browser": "rstest run -c rstest.browser.config.ts",
    "test:e2e": "playwright test",
    "qa:table-widths": "bun run src/test/table-width-audit.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@shoppp/contracts": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^6.5.1",
    "axios": "^1.18.1",
    "classnames": "^2.5.1",
    "compressorjs": "^1.3.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.24.0",
    "msw": "^2.15.0",
    "pdfjs-dist": "4.8.69",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pdf": "9.2.1",
    "react-router-dom": "^7.18.1",
    "xgplayer": "^3.0.26",
    "xgplayer-hls": "^3.0.26",
    "xgplayer-mp4": "^3.0.26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@rsbuild/core": "^2.1.6",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/browser": "0.11.2",
    "@rstest/core": "0.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "1.62.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "4.115.0"
  },
  "packageManager": "bun@1.3.5",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
