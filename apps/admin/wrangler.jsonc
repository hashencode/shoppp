{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shoppp-admin-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "API",
      "service": "shoppp-api-staging"
    }
  ],
  "vars": {
    "ADMIN_HOSTNAME": "shoppp-admin-staging.hashencode.workers.dev"
  },
  "env": {
    "fashion-staging": {
      "name": "shoppp-admin-fashion-staging",
      "vars": {
        "ADMIN_HOSTNAME": "shoppp-admin-fashion-staging.hashencode.workers.dev"
      },
      "services": [
        {
          "binding": "API",
          "service": "shoppp-api-fashion-staging"
        }
      ]
    },
    "staging": {
      "name": "shoppp-admin-staging",
      "vars": {
        "ADMIN_HOSTNAME": "shoppp-admin-staging.hashencode.workers.dev"
      },
      "services": [
        {
          "binding": "API",
          "service": "shoppp-api-staging"
        }
      ]
    },
    "production": {
      "name": "shoppp-admin-production",
      "vars": {
        "ADMIN_HOSTNAME": "shoppp-admin-production.hashencode.workers.dev"
      },
      "services": [
        {
          "binding": "API",
          "service": "shoppp-api-production"
        }
      ]
    }
  }
}
