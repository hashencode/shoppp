{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shoppp-db-contract-tests",
  "main": "./src/test-worker.ts",
  "compatibility_date": "2026-07-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoppp-contract-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
    {
      "binding": "LEGACY_DB",
      "database_name": "shoppp-contract-legacy-test",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "preview_database_id": "00000000-0000-0000-0000-000000000003",
      "migrations_dir": "migrations",
    },
    {
      "binding": "INVALID_LEGACY_DB",
      "database_name": "shoppp-contract-invalid-legacy-test",
      "database_id": "00000000-0000-0000-0000-000000000004",
      "preview_database_id": "00000000-0000-0000-0000-000000000005",
      "migrations_dir": "migrations",
    },
    {
      "binding": "STOREFRONT_VALIDATION_UPGRADE_DB",
      "database_name": "shoppp-storefront-validation-upgrade-test",
      "database_id": "00000000-0000-0000-0000-000000000006",
      "preview_database_id": "00000000-0000-0000-0000-000000000007",
      "migrations_dir": "migrations",
    },
  ],
}
